        <div class="layout-footer"></div>
      </div>
    </div>
    <div class="page-loading" style="display: none;"></div>

    <!-- 就業状況通知書 Modal -->
    <div id="employmentNoticeModal" class="enm-modal" hidden>
      <div class="enm-backdrop" id="enmBackdrop"></div>
      <div class="enm-content">
        <div class="enm-header">
          <h3>出勤簿</h3>
          <div style="display:flex;gap:8px;align-items:center;margin-left:auto;margin-right:16px;">
            <label style="font-size:12px;color:#475569;">用紙:</label>
            <select id="enmPaperSize" style="font-size:12px;padding:2px 8px;border:1px solid #cbd5e1;border-radius:4px;">
              <option value="A4-portrait">A4 縦</option>
              <option value="A4-landscape">A4 横</option>
              <option value="A3-portrait">A3 縦</option>
              <option value="A3-landscape">A3 横</option>
            </select>
          </div>
          <button type="button" class="enm-close" id="btnEnmClose" aria-label="閉じる">×</button>
        </div>
        <div class="enm-body" id="enmPrintArea">
          <div class="enm-paper">
            <div class="enm-title"><span>出勤簿</span></div>

            <!-- Dòng tiêu đề kiểu hành chính: 年 月 ・ 名前 ・ 印 ・ 合計日数 -->
            <div class="enm-name-line">
              <span id="enmYmLine" class="enm-ym"></span>
              <span class="enm-name-label">名前：</span>
              <span id="enmNameLine" class="enm-name-val"></span>
              <span class="enm-stamp">印</span>
              <span class="enm-total-inline">合計日数：<span id="enmTotalDays">0日</span></span>
            </div>

            <table class="enm-daily-table" id="enmDailyTable">
              <thead>
                <tr>
                  <th rowspan="2" style="width: 7%;"><div class="thc thc2">日</div></th>
                  <th rowspan="2" style="width: 9%;"><div class="thc thc2">事由</div></th>
                  <th colspan="3" style="width: 18%;"><div class="thc thc1">就業現場</div></th>
                  <th colspan="2" style="width: 14%;"><div class="thc thc1">就業時間</div></th>
                  <th colspan="2" style="width: 14%;"><div class="thc thc1">休憩時間</div></th>
                  <th rowspan="2" style="width: 9%;"><div class="thc thc2">中抜け<br>時間</div></th>
                  <th rowspan="2" style="width: 10%;"><div class="thc thc2">勤務時間</div></th>
                  <th rowspan="2" style="width: 10%;"><div class="thc thc2">超過時間</div></th>
                  <th rowspan="2" style="width: 9%;"><div class="thc thc2">備考</div></th>
                </tr>
                <tr>
                  <th><div class="thc thc1">出社</div></th>
                  <th><div class="thc thc1">在宅</div></th>
                  <th><div class="thc thc1">現場</div></th>
                  <th><div class="thc thc1">開始</div></th>
                  <th><div class="thc thc1">終了</div></th>
                  <th><div class="thc thc1">普通</div></th>
                  <th><div class="thc thc1">深夜</div></th>
                </tr>
              </thead>
              <tbody>
                <!-- Rows will be injected here by JS -->
              </tbody>
            </table>

            <div class="enm-footer-text" style="margin-top: 8px; font-size: 15px; text-align: right;">
              上記の通り、就業状況を通知いたします。
            </div>
            <div class="enm-company-bottom"><%= (typeof tenant !== 'undefined' && tenant && tenant.name) ? tenant.name : '飯塚塗研株式会社' %></div>
          </div>
        </div>
        <div class="enm-footer">
          <button type="button" class="se-btn" id="btnEnmCloseBottom">閉じる</button>
          <button type="button" class="se-btn primary" id="btnEnmPrint">印刷 / PDF保存</button>
        </div>
      </div>
    </div>
